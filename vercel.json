{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/tithi-reminder",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron/aradhana-reminder",
      "schedule": "30 15 * * *"
    }
  ]
}
